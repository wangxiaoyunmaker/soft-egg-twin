{
  "name": "soft-egg-twin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/prepare-tracking.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "validate:physics": "node --experimental-strip-types scripts/validate-physics.ts",
    "preview": "vite preview --host 127.0.0.1",
    "prepare:tracking": "node scripts/prepare-tracking.mjs",
    "dev:background": "node scripts/start-dev.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "0.185.4",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "packageManager": "pnpm@11.14.0"
}
